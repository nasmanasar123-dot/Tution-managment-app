</main>
<% const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  users: '<circle cx="9" cy="8" r="4"/><path d="M2 21v-1a6 6 0 0 1 12 0v1"/><path d="M16 4a4 4 0 0 1 0 8M22 21v-1a6 6 0 0 0-4-5.6"/>',
  check: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M8.5 15l2.5 2.5 5-5"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
};
const mobileNav = [['/', 'Home', 'home'], ['/students', 'Students', 'users'], null, ['/attendance', 'Attendance', 'check'], ['/reports', 'Reports', 'chart']]; %>
<nav class="bottomnav">
  <% mobileNav.forEach(item => { if (!item) { %>
    <a href="/collect" class="fab" aria-label="Collect fee"><span>₹</span><small>Collect</small></a>
  <% } else { const [href, label, icon] = item; const on = href === '/' ? path === '/' : path.startsWith(href); %>
    <a href="<%= href %>" class="<%= on ? 'on' : '' %>">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- icons[icon] %></svg>
      <span><%= label %></span>
    </a>
  <% } }) %>
</nav>
<script src="/js/app.js"></script>
</body>
</html>
